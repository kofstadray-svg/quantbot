# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to git — it contains live API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
# "dev"  → paper trading enforced, verbose logging, all safety checks on
# "prod" → live trading allowed, INFO logging
ENV=dev

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Required — used for Stage-2 signal scoring and autoresearch
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Alpaca ────────────────────────────────────────────────────────────────────
# Required — paper trading is free, sign up at https://alpaca.markets
# dev:  paper endpoint enforced even if you set the live URL
# prod: uncomment the live URL and set ENV=prod
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_BASE_URL=https://api.alpaca.markets    # live — also requires ENV=prod

# ── Tiingo — secondary OHLCV provider (optional) ─────────────────────────────
# Falls back to yfinance when absent.
# Sign up at https://tiingo.com
# Free tier: 1,000 req/day — workable for development.
# Power tier: 100,000 req/day — recommended for live scanning.
TIINGO_API_KEY=

# ── Financial Modeling Prep — RS universe, float, earnings (optional) ─────────
# Enables RS rank computation across S&P 500 + Nasdaq 100 (~600 stocks).
# Required for Setup B (Institutional Breakout) RS gate.
# Sign up at https://financialmodelingprep.com — Starter plan ~$19/mo
FMP_API_KEY=

# ── FinnHub — news sentiment, earnings surprises, webhooks (optional) ─────────
# Enhances signal quality gate and enables real-time news alerts.
# Sign up at https://finnhub.io — free tier covers 60 calls/min.
FINNHUB_API_KEY=
FINNHUB_WEBHOOK_SECRET=      # Set this to a random string; enter the same value in FinnHub dashboard

# ── Telegram bot (optional but highly recommended) ────────────────────────────
# Create a bot via @BotFather at https://t.me/BotFather
# Get your chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Webhook server (TradingView alert bridge) ─────────────────────────────────
# Use a long random string — this is the shared secret for TradingView alerts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

# ── TradingView MCP (optional) ────────────────────────────────────────────────
MCP_AUTH_TOKEN=
TV_MCP_URL=

# ── Unusual Whales — options flow (optional) ──────────────────────────────────
UNUSUAL_WHALES_API_KEY=

# ── Polymarket prediction markets (optional) ──────────────────────────────────
POLYMARKET_PRIVATE_KEY=0x...
POLYMARKET_WALLET_ADDRESS=0x...
POLYMARKET_HOST=https://clob.polymarket.com

# ── Risk limits ───────────────────────────────────────────────────────────────
MAX_POSITION_SIZE_USD=500    # Maximum notional per trade
DAILY_LOSS_LIMIT_USD=100     # Stop new buys if daily losses exceed this
